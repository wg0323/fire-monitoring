<view class="fm-page">
  <view class="fm-title">消息</view>
  <view class="fm-subtitle">报警、隐患与系统通知；点击查看对应业务详情。</view>

  <view wx:if="{{loading && items.length === 0}}" class="fm-card">
    <view class="fm-empty">加载中…</view>
  </view>
  <view wx:elif="{{items.length === 0}}" class="fm-card">
    <view class="fm-empty">暂无消息</view>
  </view>

  <view
    wx:for="{{items}}"
    wx:key="id"
    class="fm-card message-card"
    data-id="{{item.id}}"
    data-type="{{item.type}}"
    data-related="{{item.relatedId}}"
    data-unread="{{item.unread}}"
    aria-role="button" bindtap="openItem"
  >
    <view class="message-card__head">
      <view class="message-card__type">
        <view wx:if="{{item.unread}}" class="unread-dot" />
        <text>{{item.typeText}}</text>
      </view>
      <text class="fm-muted">{{item.timeText}}</text>
    </view>
    <view class="message-card__content">{{item.content}}</view>
  </view>

  <view wx:if="{{loading && items.length > 0}}" class="fm-empty">加载中…</view>
  <view wx:elif="{{!hasMore && items.length > 0}}" class="fm-empty">没有更多了</view>
</view>
