.message-card {
  margin-top: 20rpx;
}

.message-card__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.message-card__type {
  display: flex;
  align-items: center;
  gap: 10rpx;
  color: var(--fm-primary);
  font-size: 25rpx;
}

.unread-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--fm-danger);
}

.message-card__content {
  margin-top: 12rpx;
  font-size: 28rpx;
  line-height: 1.6;
}
