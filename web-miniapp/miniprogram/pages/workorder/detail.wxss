.order-page {
  padding-bottom: 260rpx;
}

.order-head {
  padding: 28rpx;
  margin-bottom: 20rpx;
  border-left: 8rpx solid #17395a;
  border-radius: 20rpx;
  background: #ffffff;
}

.order-head__title {
  font-size: 34rpx;
  font-weight: 600;
}

.order-head__status {
  margin: 8rpx 0;
  color: #17395a;
  font-size: 26rpx;
}

.info-row {
  display: flex;
  gap: 24rpx;
  padding: 10rpx 0;
  font-size: 26rpx;
}

.info-label {
  width: 140rpx;
  flex-shrink: 0;
  color: #98a2b3;
}

.order-photos {
  margin-top: 20rpx;
}

.order-photos__title {
  margin-bottom: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.order-photos__grid {
  display: flex;
  gap: 16rpx;
}

.order-photos__item {
  width: 180rpx;
  height: 135rpx;
  border-radius: 12rpx;
  background: #f4f6f9;
}

.action-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  box-shadow: 0 -4rpx 20rpx rgb(16 24 40 / 8%);
}

.action-bar__hint {
  margin-bottom: 12rpx;
  color: #98a2b3;
  font-size: 22rpx;
}

.action-bar__buttons {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.action-bar__buttons .fm-btn {
  min-width: 0;
  width: 100%;
  padding-left: 0;
  padding-right: 0;
}

.panel-mask {
  position: fixed;
  inset: 0;
  z-index: 100;
  display: flex;
  align-items: flex-end;
  background: rgb(16 24 40 / 50%);
}

.panel {
  width: 100%;
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  border-radius: 28rpx 28rpx 0 0;
  background: #ffffff;
}

.panel__title {
  font-size: 32rpx;
  font-weight: 600;
}

.panel__textarea {
  width: 100%;
  height: 160rpx;
  padding: 20rpx;
  margin-top: 20rpx;
  border: 1rpx solid #e4e7ec;
  border-radius: 16rpx;
  font-size: 26rpx;
}

.panel__label {
  margin: 20rpx 0 12rpx;
  color: var(--fm-text-secondary);
  font-size: 26rpx;
}

.panel__actions {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
  margin-top: 24rpx;
}
