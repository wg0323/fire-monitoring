.page-head {
  margin-bottom: 24rpx;
}

.tabs {
  display: flex;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.tab {
  padding: 10rpx 28rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: #475467;
  font-size: 26rpx;
}

.tab.is-active {
  background: #17395a;
  color: #ffffff;
}

.order-card {
  margin-bottom: 16rpx;
}

.order-card__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.order-card__merchant {
  flex: 1;
  overflow: hidden;
  font-size: 30rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.order-card__line {
  margin-top: 8rpx;
  color: #475467;
  font-size: 25rpx;
}

.order-card__foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
  color: #98a2b3;
  font-size: 23rpx;
}

.order-card__actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.mini-btn {
  padding: 0 24rpx;
  margin: 0;
  border-radius: 999rpx;
  font-size: 24rpx;
  line-height: 56rpx;
}

.mini-btn--primary {
  background: #17395a;
  color: #ffffff;
}

.mini-btn::after {
  border: none;
}
