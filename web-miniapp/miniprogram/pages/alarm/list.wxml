<view class="fm-page">
  <view class="page-head">
    <view class="fm-title">报警</view>
    <view class="fm-subtitle">{{roleText}} · {{isMerchant ? '本店报警' : '按角色范围展示'}}</view>
  </view>

  <view class="tabs">
    <view
      wx:for="{{tabs}}"
      wx:key="key"
      class="tab {{activeTab === item.key ? 'is-active' : ''}}"
      data-key="{{item.key}}"
      aria-role="button" bindtap="switchTab"
    >
      {{item.label}}
    </view>
  </view>

  <view wx:if="{{alarms.length === 0 && !loading}}" class="fm-card">
    <view class="fm-empty">当前没有报警</view>
  </view>

  <view
    wx:for="{{alarms}}"
    wx:key="id"
    class="fm-card alarm-card {{item.levelClass}}"
    data-id="{{item.id}}"
    aria-role="button" bindtap="openDetail"
  >
    <view class="alarm-card__head">
      <text class="alarm-card__merchant">{{item.merchantName}}</text>
      <text wx:if="{{item.pendingReview}}" class="fm-tag fm-tag--accent">待复核</text>
      <text wx:else class="fm-tag">{{item.statusText}}</text>
    </view>
    <view class="alarm-card__line">
      <text class="alarm-card__level">{{item.levelText}}</text>
      <text>设备 {{item.sn}}</text>
    </view>
    <view class="alarm-card__line">{{item.position}}</view>
    <view class="alarm-card__foot">
      <text>{{item.timeText}}</text>
      <text class="fm-muted">查看</text>
    </view>
  </view>

  <view wx:if="{{loading}}" class="fm-empty">加载中…</view>
  <view wx:elif="{{!hasMore && alarms.length > 0}}" class="fm-empty">没有更多了</view>
</view>
