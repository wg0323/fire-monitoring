<wxs src="../../utils/file.wxs" module="file" />
<view class="fm-page detail-page">
  <view wx:if="{{!detail && loading}}" class="fm-empty">加载中…</view>
  <view wx:elif="{{!detail}}" class="fm-empty">报警不存在</view>

  <block wx:else>
    <view class="detail-head {{detail.levelClass}}">
      <view class="detail-head__line">
        <text class="detail-head__level">{{detail.levelText}}</text>
        <text class="fm-tag">{{detail.statusText}}</text>
      </view>
      <view class="detail-head__merchant">{{detail.merchantName}}</view>
      <view class="detail-head__time">{{detail.alarmTimeText}}</view>
    </view>

    <view class="fm-card">
      <view class="info-row">
        <text class="info-label">设备编号</text>
        <text>{{detail.sn}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">设备类型</text>
        <text>{{detail.deviceTypeName}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">位置</text>
        <text>{{detail.position}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">处置结论</text>
        <text>{{detail.resultText}}</text>
      </view>
      <view wx:if="{{detail.faultText}}" class="info-row">
        <text class="info-label">转隐患</text>
        <text>{{detail.faultText}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">收口人</text>
        <text>{{detail.handlerName}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">收口时间</text>
        <text>{{detail.finalizeTimeText}}</text>
      </view>
      <view wx:if="{{detail.addRemark}}" class="info-row">
        <text class="info-label">说明</text>
        <text>{{detail.addRemark}}</text>
      </view>
    </view>

    <image
      wx:if="{{detail.snapshotUrl}}"
      class="detail-snapshot"
      src="{{file.fileUrl(detail.snapshotUrl, fileBase)}}"
      mode="widthFix"
    />

    <view wx:if="{{detail.photos.length}}" class="fm-card detail-photos">
      <view class="detail-photos__title">现场照片</view>
      <view class="detail-photos__grid">
        <image
          wx:for="{{detail.photos}}"
          wx:key="*this"
          class="detail-photos__item"
          src="{{file.fileUrl(item, fileBase)}}"
          mode="aspectFill"
          data-src="{{item}}"
          aria-role="button" bindtap="previewPhoto"
        />
      </view>
    </view>

    <view class="fm-section-title">时间线</view>
    <view wx:if="{{timeline.length === 0}}" class="fm-card">
      <view class="fm-empty">暂无时间线</view>
    </view>
    <view wx:else class="fm-card trace-card">
      <van-steps
        steps="{{timeline}}"
        active="{{timeline.length}}"
        direction="vertical"
        active-color="#17395A"
        inactive-color="#98A2B3"
        desc-class="trace-desc"
      />
    </view>

    <view wx:if="{{isMerchant && !canHandle && !detail.isFault}}" class="fm-card">
      <view class="fm-empty">该报警已处置，无需重复提交。</view>
    </view>
    <view wx:if="{{detail.isFault}}" class="fm-card">
      <view class="fm-empty">设备故障由系统自动或人工转隐患；如已自行恢复则不转，处置请在隐患流程中查看。</view>
    </view>
  </block>

  <view wx:if="{{canHandle}}" class="action-bar">
    <view class="action-bar__hint">商户处置：火警需值守复核，误报直接收口。</view>
    <view class="action-bar__buttons">
      <button class="fm-btn fm-btn--danger" data-result="1" aria-role="button" bindtap="openPanel">火警</button>
      <button class="fm-btn fm-btn--ghost" data-result="0" aria-role="button" bindtap="openPanel">误报</button>
    </view>
  </view>

  <view wx:if="{{panelVisible}}" class="panel-mask" aria-role="button" bindtap="closePanel">
    <view class="panel" catchtap="noop">
      <view class="panel__title">确认为「{{handleTitle}}」？</view>
      <textarea
        class="panel__textarea"
        placeholder="补充说明（选填）"
        maxlength="255"
        value="{{remark}}"
        bindinput="onRemarkInput"
      />
      <view class="panel__label">现场照片（选填，最多 3 张）</view>
      <fm-photo-picker value="{{pics}}" bind:change="onPicsChange" />
      <view wx:if="{{handleResult === 1}}" class="panel__tip">提交后进入待值守复核，值守确认后才算真警。</view>
      <view wx:if="{{handleResult === 0}}" class="panel__tip">提交后报警直接收口，不再进入复核。</view>
      <view class="panel__actions">
        <button class="fm-btn fm-btn--ghost" aria-role="button" bindtap="closePanel">取消</button>
        <button class="fm-btn fm-btn--primary" loading="{{submitting}}" aria-role="button" bindtap="submitHandle">确认提交</button>
      </view>
    </view>
  </view>
</view>
