.list-head {
  margin-bottom: 24rpx;
}

.plan-card {
  margin-bottom: 20rpx;
}

.plan-card__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.plan-card__name {
  font-size: 30rpx;
  font-weight: 600;
}

.plan-card__status {
  font-size: 24rpx;
}

.plan-status-0 {
  color: var(--fm-text-muted);
}

.plan-status-1 {
  color: var(--fm-primary);
}

.plan-status-2 {
  color: var(--fm-offline);
}

.plan-card__line {
  margin-top: 8rpx;
  color: var(--fm-text-secondary);
  font-size: 26rpx;
}

.plan-card__progress {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 16rpx;
}

.progress-bar {
  flex: 1;
  height: 12rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #eef2f6;
}

.progress-bar__inner {
  height: 100%;
  border-radius: 999rpx;
  background: var(--fm-primary);
}

.plan-card__foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
}

.plan-card__link {
  color: var(--fm-primary);
  font-size: 26rpx;
}
