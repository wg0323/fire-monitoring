.form-card {
  margin-top: 24rpx;
}

.form-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding: 16rpx 0;
}

.form-label {
  flex-shrink: 0;
  color: var(--fm-text-secondary);
  font-size: 27rpx;
}

.form-value {
  flex: 1;
  color: var(--fm-text);
  font-size: 27rpx;
  text-align: right;
}

.form-value--placeholder {
  color: var(--fm-text-muted);
}

.form-block {
  padding: 16rpx 0;
}

.type-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 16rpx;
}

.type-item {
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  background: #f9fafb;
  color: var(--fm-text-secondary);
  font-size: 25rpx;
}

.type-item--active {
  background: var(--fm-primary-soft);
  color: var(--fm-primary);
}

.form-textarea {
  width: 100%;
  min-height: 170rpx;
  margin-top: 16rpx;
  padding: 20rpx;
  border-radius: var(--fm-radius-sm);
  background: #f9fafb;
  font-size: 27rpx;
}

.submit-btn {
  margin-top: 32rpx;
}

.panel-mask {
  position: fixed;
  inset: 0;
  z-index: 50;
  display: flex;
  align-items: flex-end;
  background: rgb(16 24 40 / 45%);
}

.panel {
  width: 100%;
  max-height: 76vh;
  padding: 28rpx 32rpx calc(28rpx + env(safe-area-inset-bottom));
  border-radius: var(--fm-radius-lg) var(--fm-radius-lg) 0 0;
  background: var(--fm-card-bg);
}

.panel__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.panel__title {
  font-size: 32rpx;
  font-weight: 600;
}

.panel__close {
  padding: 0 12rpx;
  color: var(--fm-text-muted);
  font-size: 40rpx;
  line-height: 1;
}

.panel__search {
  width: 100%;
  height: 80rpx;
  padding: 0 24rpx;
  border-radius: var(--fm-radius-sm);
  background: #f9fafb;
  color: var(--fm-text);
  font-size: 27rpx;
}

.merchant-list {
  max-height: 50vh;
  margin-top: 16rpx;
}

.merchant-item {
  padding: 20rpx 8rpx;
  border-bottom: 1rpx solid var(--fm-border);
}

.merchant-item__name {
  margin-bottom: 6rpx;
  font-size: 28rpx;
  font-weight: 500;
}
