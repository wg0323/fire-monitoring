.page-head {
  margin-bottom: 24rpx;
}

.search-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.search-input {
  flex: 1;
  height: 80rpx;
  padding: 0 24rpx;
  background: var(--fm-card-bg);
  border-radius: var(--fm-radius-sm);
  color: var(--fm-text);
  font-size: 26rpx;
}

.search-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 128rpx;
  height: 80rpx;
  margin: 0;
  padding: 0;
  background: var(--fm-primary);
  border-radius: var(--fm-radius-sm);
  color: #ffffff;
  font-size: 26rpx;
}

.search-btn::after {
  border: none;
}

.tabs {
  display: flex;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.tab {
  padding: 10rpx 28rpx;
  border-radius: 999rpx;
  background: var(--fm-card-bg);
  color: var(--fm-text-secondary);
  font-size: 26rpx;
}

.tab.is-active {
  background: var(--fm-primary);
  color: #ffffff;
}

.summary {
  margin-bottom: 16rpx;
  color: var(--fm-text-muted);
  font-size: 24rpx;
}

.device-card {
  margin-bottom: 16rpx;
}

.device-card__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.device-card__name {
  flex: 1;
  overflow: hidden;
  font-size: 30rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.fm-tag--online {
  background: #ecfdf3;
  color: #027a48;
}

.fm-tag--offline {
  background: #f2f4f7;
  color: #667085;
}

.device-card__line {
  margin-top: 8rpx;
  color: var(--fm-text-secondary);
  font-size: 25rpx;
}

.device-card__foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
  color: var(--fm-text-muted);
  font-size: 23rpx;
}

.list-tip {
  padding: 24rpx 0 40rpx;
  color: var(--fm-text-muted);
  font-size: 24rpx;
  text-align: center;
}
