@import '../styles/icons.wxss';

.tab-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 100;
  display: flex;
  height: 100rpx;
  height: calc(100rpx + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  background: #ffffff;
  border-top: 1rpx solid #e4e7ec;
}

.tab-item {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  color: #98a2b3;
  font-size: 22rpx;
}

.tab-item__icon {
  width: 40rpx;
  height: 40rpx;
}

.tab-item__text {
  line-height: 30rpx;
}

.tab-item.is-active {
  color: #17395a;
  font-weight: 600;
}
